    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "lighthouse": "^13.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
